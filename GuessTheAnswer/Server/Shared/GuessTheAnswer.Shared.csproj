<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity project's Shared folder exactly as Unity does (.NET Standard 2.1, C# 9),
       so the server and the game client always run the same rules. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GuessTheAnswer.Shared</AssemblyName>
    <RootNamespace>GuessTheAnswer.Shared</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/GuessTheAnswer/Scripts/Shared/**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
