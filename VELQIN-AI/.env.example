# ---------------------------------------------------------------------------------------------
# VELQIN AI configuration. Copy to ".env" (the installer does this) and adjust if needed.
# Every value is optional — the defaults work for a single Windows PC.
# ---------------------------------------------------------------------------------------------

# Web server. 0.0.0.0 = reachable from phones/tablets in your Wi-Fi. Use 127.0.0.1 for this PC only.
VELQIN_HOST=0.0.0.0
VELQIN_PORT=8080

# Where the database, uploads and generated media are stored.
# VELQIN_DATA_DIR=D:/VELQIN-data

# Local AI services — keep them on 127.0.0.1 so they are NEVER reachable from outside.
VELQIN_OLLAMA_URL=http://127.0.0.1:11434
VELQIN_COMFYUI_URL=http://127.0.0.1:8188
VELQIN_SEARXNG_URL=http://127.0.0.1:8888

# FFmpeg (needed for video export). Leave as-is if ffmpeg is on PATH.
# VELQIN_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# VELQIN_FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Session cookies: "auto" marks cookies Secure when the request came over HTTPS.
VELQIN_COOKIE_SECURE=auto
# Set to true ONLY when VELQIN sits behind your own reverse proxy (Caddy) — see docs/REMOTE_ACCESS.md.
VELQIN_TRUST_PROXY_HEADERS=false
VELQIN_SESSION_DAYS=30

# Optional: create the owner account automatically on first start (otherwise use the /setup page).
# VELQIN_OWNER_USERNAME=admin
# VELQIN_OWNER_PASSWORD=change-me-please

# Voice input (optional, needs: pip install -r backend/requirements-optional.txt)
VELQIN_WHISPER_MODEL=small
VELQIN_WHISPER_DEVICE=cpu

VELQIN_LOG_LEVEL=INFO
# development = enables API docs at /api/docs and the Next.js dev server origin
VELQIN_ENVIRONMENT=production
