# ── Mobile client (public values only — these are bundled into the app) ──────
# Supabase project URL and *anon* key. The anon key is designed to be public;
# Row Level Security in supabase/migrations protects every table.
# Leave both empty to run ASCEND fully offline (local storage + offline coach).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Show "Continue with Apple / Google" buttons. Only enable after configuring
# the providers in Supabase → Authentication → Providers.
EXPO_PUBLIC_ENABLE_OAUTH=false

# ── Server-side secrets (NEVER put these in the app or in EXPO_PUBLIC_*) ─────
# Set them as Supabase Edge Function secrets instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set COACH_MODEL=claude-opus-5-5
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions.
